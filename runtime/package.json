{
	"name": "@wasm-fmt/runtime",
	"version": "0.0.0",
	"description": "JavaScript host runtime for the wasm-fmt Bridge ABI",
	"author": "magic-akari <akari.ccino@gmail.com>",
	"keywords": [
		"formatter",
		"webassembly",
		"wasm"
	],
	"license": "MIT OR Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wasm-fmt/bridge.git",
		"directory": "runtime"
	},
	"homepage": "https://github.com/wasm-fmt/bridge/tree/main/runtime#readme",
	"bugs": {
		"url": "https://github.com/wasm-fmt/bridge/issues"
	},
	"publishConfig": {
		"access": "public"
	},
